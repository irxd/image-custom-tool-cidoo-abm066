<Window>
<ShootControl name="ShootControlItem">
	<VerticalLayout height="490" width="770" padding="0,0,0,0" bkcolor="#FF285155">
		<!--枪的切换-->
		<HorizontalLayout width="740" height="220" padding="15,10,0,0" bkcolor="#00ffffff">
			<VerticalLayout height="220" width="118" padding="0,0,0,0" bkcolor="#00ffffff">
				<Option style="button_style" name="shoot_gun_op_0" text="gun_1_txt" width="95" height="50" padding="0,3,0,0" resourcetext="true" />
				<Option style="button_style" name="shoot_gun_op_1" text="gun_2_txt" width="95" height="50" padding="0,3,0,0" resourcetext="true" />
				<Option style="button_style" name="shoot_gun_op_2" text="gun_3_txt" width="95" height="50" padding="0,3,0,0" resourcetext="true" />
				<Option style="button_style" name="shoot_gun_op_3" text="gun_4_txt" width="95" height="50" padding="0,3,0,0" resourcetext="true" />	
			</VerticalLayout>
			<TabLayout name="shoot_image_display_switch" height="220" width="615" padding="10,0,0,0" bkimage="file='Shootkey/bg_pay_mode_normal.png'" bkcolor="#00ffffff">
					<!-- 枪1 -->			
					<VerticalLayout height="220" width="600" padding="50,0,0,0">
					    <Label width="498" height="197"  bkimage="file='Shootkey/AK47.png'" padding="10,15,0,0" />  					 
					</VerticalLayout>
					<!-- 枪2 -->
					<VerticalLayout height="250" width="650" padding="40,0,0,0">
					   <Label width="549" height="174"  bkimage="file='Shootkey/M416.png'" padding="0,15,0,0" />       		  					 
					</VerticalLayout>
					<!-- 枪3 -->
					<VerticalLayout height="250" width="650" padding="20,0,0,0">
					 	  <Label width="581" height="170"  bkimage="file='Shootkey/M16A4_5.png'" padding="0,25,0,0" />			 		        		  					 
					</VerticalLayout>
					<!-- 枪4 -->
				<VerticalLayout height="250" width="650" padding="50,0,0,0">
					<Label width="385" height="201"  bkimage="file='Shootkey/SCAR-L_72.png'" padding="40,15,0,0" />			 		        		  					 
				</VerticalLayout>
			</TabLayout >
		</HorizontalLayout>
		<!--机械师数据设置-->
		<HorizontalLayout width="160" height="30" padding="595,10,0,0" bkcolor="#ff17393c">
			<Button name="shootdate_import_btn" tooltip="profile_import_text" width="30" height="30" padding="10,0,0,0"
					normalimage="file='common/profile_import_normal.png'"
					hotimage="file='common/profile_import_hot.png'"
					pushedimage="file='common/profile_import_down.png'" 
					disabledimage="file='common/profile_import_disable.png'" visible="true" resourcetext="true" font="2"/>
			<Button name="shootdate_export_btn" tooltip="profile_export_text" width="30" height="30" padding="10,0,0,0"
					normalimage="file='common/profile_export_normal.png'"
					hotimage="file='common/profile_export_hot.png'"
					pushedimage="file='common/profile_export_down.png'" 
					disabledimage="file='common/profile_export_disable.png'" visible="true" resourcetext="true" font="2" />	
			<Button name="shootdate_save_btn" tooltip="key_set_apply_text" resourcetext="true" font="2" width="30" height="30" padding="10,0,0,0"
					normalimage="file='common/profile_save_normal.png'"
					hotimage="file='common/profile_save_hot.png'"
					pushedimage="file='common/profile_save_down.png'" 
					disabledimage="file='common/profile_save_disable.png'"/>			
			<Button name="shootdate_reset_btn" tooltip="default_set_text" resourcetext="true" font="2" width="30" height="30" padding="10,0,0,0"
					normalimage="file='common/profile_reset_normal.png'"
					hotimage="file='common/profile_reset_hot.png'"
					pushedimage="file='common/profile_reset_down.png'" 
					disabledimage="file='common/profile_reset_disable.png'"/>
		</HorizontalLayout>
		<!--机械师子弹设置-->
		<VerticalLayout width="740" height="100" bkcolor="#ff17393c" padding="15,10,0,0">
			<HorizontalLayout width="733" height="16" padding="0,3,0,0" >
				<Label text="bullet_select_text" style="label_style" height="16" font="4" resourcetext="true" padding="20,0,0,0" />	
				<Label name="bullet_select_index" style="label_style" height="16" font="4" resourcetext="false" padding="10,0,0,0" />	
			</HorizontalLayout>	
			<HorizontalLayout width="733" height="51" padding="0,14,0,0" >
				<Button  name="bullet_selected_prev" width="18" height="17" tooltip="bullet_selected_prev_text"  padding="53,20,0,0" 
						normalimage="file='Shootkey/bullet_selected_prev_normal.png'"
						hotimage="file='Shootkey/bullet_selected_prev_hot.png'"
						pushedimage="file='Shootkey/bullet_selected_prev_down.png'" 
						disabledimage="file='Shootkey/bullet_selected_prev_disable.png'" resourcetext="true"/>
				<CheckBox width="12" height="51" name="bullet_op_0" style="gun_check_style" padding="20,5,0,0"  />
				<CheckBox width="12" height="51" name="bullet_op_1" style="gun_check_style"/>	
				<CheckBox width="7" height="40" name="bullet_op_2" style="gun_check_style"/>	
				<CheckBox width="7" height="40" name="bullet_op_3" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_4" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_5" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_6" style="gun_check_style"/>	
				<CheckBox width="7" height="40" name="bullet_op_7" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_8" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_9" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_10" style="gun_check_style"/>	
				<CheckBox width="7" height="40" name="bullet_op_11" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_12" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_13" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_14" style="gun_check_style"/>	
				<CheckBox width="7" height="40" name="bullet_op_15" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_16" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_17" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_18" style="gun_check_style"/>	
				<CheckBox width="7" height="40" name="bullet_op_19" style="gun_check_style" />
				<CheckBox width="7" height="40" name="bullet_op_20" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_21" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_22" style="gun_check_style"/>	
				<CheckBox width="7" height="40" name="bullet_op_23" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_24" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_25" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_26" style="gun_check_style"/>	
				<CheckBox width="7" height="40" name="bullet_op_27" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_28" style="gun_check_style"/>
				<CheckBox width="7" height="40" name="bullet_op_29" style="gun_check_style"/>
				<Button  name="bullet_selected_next" width="18" height="17" tooltip="bullet_selected_next_text" padding="20,20,0,0" 
						normalimage="file='Shootkey/bullet_selected_next_normal.png'"
						hotimage="file='Shootkey/bullet_selected_next_hot.png'"
						pushedimage="file='Shootkey/bullet_selected_next_down.png'" 
						disabledimage="file='Shootkey/bullet_selected_next_disable.png'" resourcetext="true" />
			</HorizontalLayout>
		</VerticalLayout>
		<!--子弹数据设置-->
		<VerticalLayout name="bullet_edit_layout" width="740" height="120" padding="15,5,0,0" bkcolor="#00ffffff">
			<HorizontalLayout width="740" height="30" padding="0,10,0,0" >
				<CheckBox name="bullet_x_check" normalimage="file='Shootkey/CursorRight.png' dest='0,0,50,25'" selectedimage="file='Shootkey/CursorLeft.png' dest='0,0,50,25'" disabledimage="file='Shootkey/CursorXdisable.png' dest='0,0,50,25'"
				text="mouse_move_to_right_text" width="160" height="25"  font="4" padding="5,4,0,0" resourcetext="true" style="label_style" textpadding="65,0,0,0"/>					  
				<Edit  name="bullet_x_eidt" style="edit_style"  width="100" height="30" maxchar="3" padding="5,0,0,0" align="center" numberonly="true" min="0" max="255"/> 
			</HorizontalLayout>	
			<HorizontalLayout width="740" height="30" padding="0,15,0,0" >
				<HorizontalLayout width="300" height="30" padding="6,0,0,0" >
					<Label text="macro_list_header_delay_text" style="label_style" width="80" font="4" height="30" valign="center" resourcetext="true" padding="0,0,0,0" />
					 <Edit name="bullet_delay_eidt" style="edit_style" align="center" numberonly="true" width="184" height="30" maxchar="5" padding="0,0,0,0" min="0" max="65535"/>	
				</HorizontalLayout>
				<HorizontalLayout width="300" height="30" padding="169,0,0,0">					  
					<CheckBox name="bullet_y_check" normalimage="file='Shootkey/CursorDown.png' dest='0,0,50,25'" selectedimage="file='Shootkey/CursorUp.png' dest='0,0,50,25'" disabledimage="file='Shootkey/CursorYdisable.png' dest='0,0,50,25'"
					text="mouse_move_to_down_text" width="160" height="25"  font="4" padding="0,2,0,0" resourcetext="true" style="label_style" textpadding="65,0,0,0"/>
					
					<Edit name="bullet_y_eidt" style="edit_style" align="center" numberonly="true" width="100" height="30" maxchar="3" padding="5,0,0,0" min="0" max="255"/> 
				</HorizontalLayout>	
			</HorizontalLayout>
		</VerticalLayout>
		<HorizontalLayout  width="770" height="350" padding="0,5,0,0" bkcolor="#00ffffff">

			<VerticalLayout height="600" width="900" padding="10,0,0,0" >		
				<VerticalLayout height="210" enabled="true">

					

				</VerticalLayout>
			</VerticalLayout>
		</HorizontalLayout>
	</VerticalLayout>
</ShootControl>
</Window>