						<Label text="125Hz" height="11" style="label_style" font="9" align="center" padding="0,10,0,0"/>
					</VerticalLayout>
					
					<VerticalLayout width="30" padding="0,0,0,0">
						<Slider name="6533_eq_hz_slider_3" min="-20" max="20" value="4" style="vslider_style" width="14" height="125" isstretchfore="true" hor="false" padding="8,0,0,0"  />
						<Label text="250Hz" height="11" style="label_style" font="9" align="center" padding="0,10,0,0"/>
					</VerticalLayout>
					
					<VerticalLayout width="30" padding="0,0,0,0">
						<Slider name="6533_eq_hz_slider_4" min="-20" max="20" value="4" style="vslider_style" width="14" height="125" isstretchfore="true" hor="false" padding="8,0,0,0"  />
						<Label text="500Hz" height="11" style="label_style" font="9" align="center" padding="0,10,0,0"/>
					</VerticalLayout>
					
					<VerticalLayout width="30" padding="0,0,0,0">
						<Slider name="6533_eq_hz_slider_5" min="-20" max="20" value="4" style="vslider_style" width="14" height="125" isstretchfore="true" hor="false" padding="8,0,0,0"  />
						<Label text="1KHz" height="11" style="label_style" font="9" align="center" padding="0,10,0,0"/>
					</VerticalLayout>
					
					<VerticalLayout width="30" padding="0,0,0,0">
						<Slider name="6533_eq_hz_slider_6" min="-20" max="20" value="4" style="vslider_style" width="14" height="125" isstretchfore="true" hor="false" padding="8,0,0,0"  />
						<Label text="2KHz" height="11" style="label_style" font="9" align="center" padding="0,10,0,0"/>
					</VerticalLayout>
					
					<VerticalLayout width="30" padding="0,0,0,0">
						<Slider name="6533_eq_hz_slider_7" min="-20" max="20" value="4" style="vslider_style" width="14" height="125" isstretchfore="true" hor="false" padding="8,0,0,0"  />
						<Label text="4KHz" height="11" style="label_style" font="9" align="center" padding="0,10,0,0"/>
					</VerticalLayout>
					
					<VerticalLayout width="30" padding="0,0,0,0">
						<Slider name="6533_eq_hz_slider_8" min="-20" max="20" value="4" style="vslider_style" width="14" height="125" isstretchfore="true" hor="false" padding="8,0,0,0"  />
						<Label text="8KHz" height="11" style="label_style" font="9" align="center" padding="0,10,0,0"/>
					</VerticalLayout>
					
					<VerticalLayout width="30" padding="0,0,0,0" >
						<Slider name="6533_eq_hz_slider_9" min="-20" max="20" value="4" style="vslider_style" width="14" height="125" isstretchfore="true" hor="false" padding="8,0,0,0"  />
						<Label text="16KHz" height="11" style="label_style" font="9" align="center" padding="0,10,0,0"/>
					</VerticalLayout>
					<Label name="voice_db" bkimage="file='hs/dB.png'" width="39" height="121"/>
				</HorizontalLayout>
				
			</VerticalLayout>
			<Label bkimage="hs/middle_line.png" width="2" height="190" padding="5,7,0,0" visible="false"/>
			<!--布局右侧-->
			<VerticalLayout width="100" padding="0,21,0,0"  >				
				
				<HorizontalLayout height="182" padding="0,0,0,0">					
					<VerticalLayout width="50" height="190" padding="0,0,0,0">
						<Slider name="6533_MicIn_slider" enabled="true" width="14" height="125" padding="18,0,0,0" value="25" min="0" max="100" style="vslider_style" isstretchfore="true" hor="false"/>					
						<Label text="Mic In" style="label_style" glowsize="0" font="9" resourcetext="false" align="center" width="50" height="11" padding="0,2,0,0"/>
						<CheckBox name="6533_MicIn_option" width="34" height="14" normalimage="file='hs/off.png'" padding="8,3,0,0" selectedimage="file='hs/on.png'"/>
					</VerticalLayout>
					
					<VerticalLayout width="50" height="190" padding="0,0,0,0" >
						<Slider name="6533_MicMoniter_slider" enabled="true" padding="18,0,0,0" width="14" height="125" value="25" min="0" max="100" style="vslider_style" isstretchfore="true" hor="false"/>			
						<Label text="Monitor" style="label_style" glowsize="0" font="9" resourcetext="false" align="center" padding="0,2,0,0" width="50" height="11"/>
