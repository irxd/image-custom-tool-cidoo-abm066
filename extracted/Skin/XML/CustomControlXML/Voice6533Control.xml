					<CheckBox name="6533_eq_option_8" width="55" font="9" height="20" text="TRIx2" style="button_style" bordercolor="#FF009089" bordersize="1" style="label_style"/>
				</HorizontalLayout>
				<HorizontalLayout height="20">
					<CheckBox name="6533_eq_option_9" width="55" font="9" height="20" text="LIVE" style="button_style" bordercolor="#FF009089" bordersize="1" style="label_style"/>
					<CheckBox name="6533_eq_option_10" width="55" font="9" height="20" text="CLASSIC" style="button_style" bordercolor="#FF009089" bordersize="1" style="label_style"/>
					<CheckBox name="6533_eq_option_11" width="55" font="9" height="20" text="BASSx3" style="button_style" bordercolor="#FF009089" bordersize="1" style="label_style"/>
					<CheckBox name="6533_eq_option_12" width="55" font="9" height="20" text="TRIx3" style="button_style" bordercolor="#FF009089" bordersize="1" style="label_style"/>
				</HorizontalLayout>
				<!--用户自定义EQ环绕音效-->
				<CheckBox name="6533_eq_option_13" width="220" height="20" bkcolor="#ffffffff" font="9" text="Custom" style="button_style" bordercolor="#FF009089" bordersize="1" style="label_style"/>				
				<VerticalLayout name="custom_eq_option_layout" height="78">	
					<Combo name="custom_eq_name_combo" style="combo_style" width="220" height="20" itemtextpadding="0,6,0,0" itemalign="center" keyboard="false"
						dropbox="bordercolor=&quot;#FF666666&quot; bordersize=&quot;1&quot; bkcolor=&quot;#FF888888&quot;" scrollselect="false" itemtextpadding="3,5,0,0" itemalign="left"/>					
					<Edit name="custom_eq_name_edit" width="220" height="20" style="edit_style" align="center"/>
					<HorizontalLayout height="20">
						<Button name="hs_EQ_btn_save" text="Save" textcolor="#ffffffff" width="110" style="button_style" bordercolor="#FF009089" bordersize="1" enabled="true"/>
						<Button name="hs_EQ_btn_delete" text="Delete" textcolor="#ffffffff" width="110" padding="0,0,0,0" style="button_style" bordercolor="#FF009089" bordersize="1" enabled="true"/>
					</HorizontalLayout>
				</VerticalLayout>	
			</VerticalLayout>	
			<Label bkimage="hs/middle_line.png" width="2" height="190" padding="5,7,0,0" visible="false"/>
			<!--布局中间-->
			<VerticalLayout width="347" padding="16,21,0,0">
				<HorizontalLayout width="400" height="161">				
					<VerticalLayout width="30" >
						<Slider name="6533_eq_hz_slider_0" min="-20" max="20" value="4" style="vslider_style" width="14" height="125" isstretchfore="true" hor="false" padding="8,0,0,0"  />
						<Label text="32Hz" height="11" style="label_style" font="9" align="center" padding="0,10,0,0"/>
					</VerticalLayout>
					
					<VerticalLayout width="30" padding="0,0,0,0" >
						<Slider name="6533_eq_hz_slider_1" min="-20" max="20" value="4" style="vslider_style" width="14" height="125" isstretchfore="true" hor="false" padding="8,0,0,0"  />
						<Label text="62Hz" height="11" style="label_style" font="9" align="center" padding="0,10,0,0"/>
