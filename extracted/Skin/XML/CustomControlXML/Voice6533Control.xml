<?xml version="1.0" encoding="UTF-8"?>
<Window>
	<Voice6533Control name="Voice6533ControlItem" width="770" height="190" padding="0,0,0,0" >
		<HorizontalLayout width="770" height="190" bkcolor="#FF285155">
			<!--布局左侧-->
			<VerticalLayout width="220" padding="59,21,0,0">
				<HorizontalLayout height="20">
					<CheckBox name="6533_eq_option_1" width="55" font="9" height="20" text="FPS" style="button_style" bordercolor="#FF009089" bordersize="1"  style="label_style"/>
					<CheckBox name="6533_eq_option_2" width="55" font="9" height="20" text="ROCK" style="button_style" bordercolor="#FF009089" bordersize="1" style="label_style"/>
					<CheckBox name="6533_eq_option_3" width="55" font="9" height="20" text="BASS" style="button_style" bordercolor="#FF009089" bordersize="1" style="label_style"/>
					<CheckBox name="6533_eq_option_4" width="55" font="9" height="20" text="TRI" style="button_style" bordercolor="#FF009089" bordersize="1" style="label_style"/>
				</HorizontalLayout>
				<HorizontalLayout height="20">
					<CheckBox name="6533_eq_option_5" width="55" font="9" height="20" text="BALANCE" style="button_style" bordercolor="#FF009089" bordersize="1" style="label_style"/>
					<CheckBox name="6533_eq_option_6" width="55" font="9" height="20" text="DANCE" style="button_style" bordercolor="#FF009089" bordersize="1" style="label_style"/>
